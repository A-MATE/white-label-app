{
  "app_name": "AMSC",
  "bundle_id": "com.a-mate.amsc",
  "theme": {
    "colors": {
      "light": {
        "brand": {
          "primary": "#FF0000",
          "secondary": "#00FF00",
          "tertiary": "#0000FF"
        },
        "background": {
          "screen": "#FFFFFF",
          "surface": "#F5F5F5"
        },
        "text": {
          "default": "#000000",
          "secondary": "#666666",
          "inverse": "#FFFFFF",
          "disabled": "#CCCCCC"
        },
        "button": {
          "primary": {
            "background": "#FF0000",
            "text": "#FFFFFF"
          },
          "secondary": {
            "background": "#EEEEEE",
            "text": "#000000"
          },
          "disabled": {
            "background": "#CCCCCC",
            "text": "#888888"
          }
        },
        "card": {
          "background": "#FFFFFF",
          "border": "#E0E0E0",
          "shadow": "rgba(0,0,0,0.1)"
        },
        "input": {
          "background": "#FFFFFF",
          "border": "#CCCCCC",
          "text": "#000000",
          "placeholder": "#999999",
          "focusBorder": "#FF0000"
        },
        "status": {
          "success": {
            "background": "#DFF0D8",
            "text": "#3C763D"
          },
          "warning": {
            "background": "#FCF8E3",
            "text": "#8A6D3B"
          },
          "error": {
            "background": "#F2DEDE",
            "text": "#A94442"
          },
          "info": {
            "background": "#D9EDF7",
            "text": "#31708F"
          }
        },
        "nav": {
          "background": "#FFFFFF",
          "icon": "#000000",
          "activeIcon": "#FF0000"
        }
      },
      "dark": {
        "brand": {
          "primary": "#FF5555",
          "secondary": "#55FF55",
          "tertiary": "#5555FF"
        },
        "background": {
          "screen": "#121212",
          "surface": "#1E1E1E"
        },
        "text": {
          "default": "#FFFFFF",
          "secondary": "#AAAAAA",
          "inverse": "#000000",
          "disabled": "#555555"
        },
        "button": {
          "primary": {
            "background": "#FF5555",
            "text": "#000000"
          },
          "secondary": {
            "background": "#333333",
            "text": "#FFFFFF"
          },
          "disabled": {
            "background": "#444444",
            "text": "#888888"
          }
        },
        "card": {
          "background": "#1E1E1E",
          "border": "#333333",
          "shadow": "rgba(0,0,0,0.4)"
        },
        "input": {
          "background": "#1E1E1E",
          "border": "#555555",
          "text": "#FFFFFF",
          "placeholder": "#AAAAAA",
          "focusBorder": "#FF5555"
