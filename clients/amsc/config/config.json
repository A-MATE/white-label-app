        "status": {
          "success": {
            "background": "#2E7D32",
            "text": "#A5D6A7"
          },
          "warning": {
            "background": "#FBC02D",
            "text": "#FFF59D"
          },
          "error": {
            "background": "#C62828",
            "text": "#EF9A9A"
          },
          "info": {
            "background": "#0288D1",
            "text": "#81D4FA"
          }
        },
        "nav": {
          "background": "#1E1E1E",
          "icon": "#AAAAAA",
          "activeIcon": "#FF5555"
        }
      }
    },
    "borderRadius": {
      "default": 8,
      "button": 6,
      "card": 12,
      "input": 4
    },
    "typography": {
      "fontFamily": "Helvetica"
    }
  },
  "features": {
    "landing": {
      "enabled": true,
      "version": 1
    },
    "signin": {
      "enabled": true,
      "version": 1
    },
    "signup": {
      "enabled": true,
      "version": 1
    },
    "profile": {
      "enabled": true,
      "version": 1
    }
