{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react", // Ajoute cette ligne pour que TypeScript reconnaisse le JSX comme du React
    "resolveJsonModule": true, // Permet l'importation de fichiers JSON
    "esModuleInterop": true, // Facilite l'importation des modules CommonJS
    "baseUrl": "./", // Optionnel : Facilite les chemins relatifs
    "paths": {
      "src/*": ["src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
